# DeepSkill AI — Docker / local environment template
# Copy this file to .env and set your own values.
# NEVER commit real API keys.

DEPLOYMENT_MODE=docker
AI_MODE=online
AI_PROVIDER=gemini
NODE_ENV=production

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash
USE_HYBRID_AI=true

MONGODB_URI=mongodb://mongodb:27017/deepskill
PYTHON_SERVICE_URL=http://ai_service:8000
CORS_ORIGIN=http://localhost:3000
